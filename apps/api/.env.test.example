# Used only when NODE_ENV=test (see vitest.config.e2e.ts and AppModule's
# ConfigModule.forRoot envFilePath). Points at the separate erp_test
# database so e2e runs never touch dev data.
NODE_ENV=test
PORT=3001
APP_NAME=demo-erp-test
CORS_ORIGIN=*

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp_app
DB_PASSWORD=erp_app_dev_pw
DB_DATABASE=erp_test
DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=5

JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=demo-erp
JWT_AUDIENCE=demo-erp-clients
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=1000

LOG_LEVEL=silent
