# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
APP_NAME=demo-erp
# Origin of the apps/web dev server (Vite default port 5173).
CORS_ORIGIN=http://localhost:5173

# Platform (public schema) database connection.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=erp_app
DB_PASSWORD=change-me
DB_DATABASE=erp_dev
DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=10

# RS256 JWT key pair. Generate with `npm run keys:generate`.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=demo-erp
JWT_AUDIENCE=demo-erp-clients
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

LOG_LEVEL=debug
